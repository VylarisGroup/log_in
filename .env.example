APP_NAME="Vylaris log_in"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Oeffentliche HTTPS-URL von log_in, exakt so, wie sie im OIDC-Issuer erscheinen soll (ohne Slash am Ende)
APP_URL=https://login.example.ch
OIDC_ISSUER=https://login.example.ch
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Produktion: MySQL/MariaDB. SQLite genuegt fuer Entwicklung/Tests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vylaris_login
DB_USERNAME=
DB_PASSWORD=

# Keine Hintergrunddienste noetig: Sessions und Cache in der Datenbank, Queue synchron.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Reverse-Proxy: Komma-getrennte IPs/CIDRs der vertrauenswuerdigen Proxys ('*' nur wenn der Server nur ueber den Proxy erreichbar ist)
TRUSTED_PROXIES=

# Dash-Anbindung (Zeitlimits in Sekunden). Die Zwischenspeicher-Dauer begrenzt die Verzoegerung beim Rechteentzug.
DASH_TIMEOUT=5
DASH_CONNECT_TIMEOUT=3
DASH_CLAIMS_CACHE_TTL=60
# Nur fuer lokale Tests mit http://localhost; in Produktion NIE true.
DASH_ALLOW_HTTP=false
